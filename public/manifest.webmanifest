{
  "id": "./",
  "name": "읽어줘 - 글 읽어주는 앱",
  "short_name": "읽어줘",
  "description": "파일, 링크, 받은 글, 성경(개역한글)을 소리 내어 읽어주는 앱",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f1fbf7",
  "theme_color": "#178c6b",
  "lang": "ko",
  "categories": [
    "books",
    "education",
    "productivity"
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "받은 글",
      "url": "./?tab=inbox"
    },
    {
      "name": "성경",
      "url": "./?tab=bible"
    }
  ],
  "share_target": {
    "action": "share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "application/pdf",
            "image/*",
            "text/*",
            "application/*",
            ".hwp",
            ".hwpx",
            ".epub",
            ".docx",
            ".pptx",
            ".xlsx"
          ]
        }
      ]
    }
  }
}